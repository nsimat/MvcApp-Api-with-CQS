@model TaskViewModel

@{
    ViewData["Titre"] = "Create";
    Layout = "_Layout";
}

<div class="row d-flex justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">

        <!-- Using a card to represent the form -->
        <div class="card border-primary-subtle shadow-sm">

            <!-- Head of the card -->
            <div class="text-center mb-3">
                <h2 class="h4 mb-1">Create task</h2>
                <p class="text-muted mb-3">Fill in the details below to create a new task</p>
            </div>
            
            <div class="card-body">

                <form asp-controller="Tasks" asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <!-- Field: Titre -->
                    <div class="mb-3">
                        <label asp-for="Title" class="form-label small fw-semibold text-dark"></label>
                        <input asp-for="Title" class="form-control form-control-lg rounded-3 fs-6" placeholder="Ex: Document a application..."/>
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>

                    <!-- Field: DateCreation -->
                    <div class="mb-3">
                        <label asp-for="DateCreation" class="form-label small fw-semibold text-dark"></label>
                        <input asp-for="DateCreation" class="form-control form-control-lg rounded-3 fs-6"/>
                        <span asp-validation-for="DateCreation" class="text-danger small"></span>
                    </div>

                    <!-- Checkbox: Using the Switch version of Bootstrap 5 -->
                    <div class="form-check mb-3">
                        <input type="hidden" asp-for="IsClosed" value="false"/>
                        <label asp-for="IsClosed" class="form-label"></label>

                        <input asp-for="IsClosed" class="form-check-input" type="checkbox" />
                        <span asp-validation-for="IsClosed" class="text-danger d-block small"></span>
                    </div>

                    <!-- Actions to trigger for the form when applying on the button -->
                    <div class="d-flex gap-2 justify-content-between align-items-center mt-4" >
                        <button type="submit" class="btn btn-primary">
                            Register 
                        </button>

                        <a asp-controller="Tasks" asp-action="Index" class="btn btn-outline-secondary ms-2">
                            Cancel 
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

