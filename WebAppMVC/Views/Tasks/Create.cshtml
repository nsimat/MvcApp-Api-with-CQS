@model TaskViewModel

@{
    ViewData["Titre"] = "Create";
    Layout = "_Layout";
}

<h1>Create a new task</h1>

<h4>Task</h4>
<hr />
<div class="row d-flex justify-content-center">
    <div class="col-12 col-md-8 col-lg-5">
            
        <!-- Using a card to represent the form -->
        <div class="card border-0 shadow-sm rounded-4 p-4 p-sm-5 bg-white my-4">
                
            <!-- Head of the card -->
            <div class="text-center mb-4">
                <h2 class="h4 fw-bold text-dark mb-1">Create task</h2>
                <p class="text-muted small">Fill in the details below to create a new task</p>
            </div>

            <form asp-controller="Tasks" asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                    
                <!-- Field: Titre -->
                <div class="mb-3">
                        <label asp-for="Title" class="form-label small fw-semibold text-dark"></label>
                        <input asp-for="Title" class="form-control form-control-lg rounded-3 fs-6" placeholder="Ex: Document a application..."/>
                        <span asp-validation-for="Title" class="text-danger small"></span>
                    </div>
                    
                    <!-- Field: DateCreation -->
                    <div class="mb-3">
                        <label asp-for="DateCreation" class="form-label small fw-semibold text-dark"></label>
                        <input asp-for="DateCreation" class="form-control form-control-lg rounded-3 fs-6" value="@DateTime.Now.ToShortDateString()"/>
                        <span asp-validation-for="DateCreation" class="text-danger small"></span>
                    </div>
                    
                    <!-- Checkbox: Using the Switch version of Bootstrap 5 -->
                    <div class="form-check form-switch card-body border rounded-3 p-3 mb-4 bg-light d-flex align-items-center justify-content-lg-start">
                        <label asp-for="IsClosed" class="form-check-label fw-medium text-dark m-1 cursor-pointer"></label>
                        <input type="hidden" asp-for="IsClosed" value="false" />
                        <input asp-for="IsClosed" class="form-check-input m-0" type="checkbox" role="switch" style="width: 2.5em; height: 1.25em;"/>
                        <span asp-validation-for="IsClosed" class="text-danger d-block small"></span>
                    </div>
                    
                    <!-- Actions to trigger for the form when applying on the button -->
                    <div class="d-flex gap-2 d-md-block">
                        <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-semibold py-2.5 fs-6 shadow-sm">
                            Register the task
                        </button>
                        
                        <a asp-controller="Tasks" asp-action="Index" class="btn btn-light btn-lg rounded-3 fw-semibold py-2.5 fs-6 text-muted mt-1 border-0">
                            Cancel task
                        </a>
                    </div>
                </form>
            </div>
    </div>
</div>

