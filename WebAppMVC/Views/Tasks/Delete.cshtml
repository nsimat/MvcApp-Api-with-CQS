@model TaskViewModel

@{
    ViewData["Title"] = "Delete a task";
    Layout = "_Layout";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <!-- Main card for attention -->
            <div class="card border-danger shadow">

                <!-- Header of the card with a warning -->
                <div class="card-header bg-danger text-white py-3">
                    <h1 class="h4 mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Definitive Deletion</h1>
                </div>

                <div class="card-body p-4">
                    <h5 class="card-title text-muted mb-3">Are you sure you want to delete this task?</h5>

                    <!-- Revised list of details for better readability -->
                    <div class="bg-light rounded p-3 mb-3">
                        <h6 class="text-secondary border-bottom pb-2 mb-3">Task Details</h6>

                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-secondary">@Html.DisplayNameFor(model => model.Title)</dt>
                            <dd class="col-sm-8 fw-bold">@Html.DisplayFor(model => model.Title)</dd>

                            <dt class="col-sm-4 text-secondary mt-2">@Html.DisplayNameFor(model => model.DateCreation)</dt>
                            <dd class="col-sm-8 mt-2">@Html.DisplayFor(model => model.DateCreation)</dd>

                            <dt class="col-sm-4 text-secondary mt-2">@Html.DisplayNameFor(model => model.IsClosed)</dt>
                            <dd class="col-sm-8 mt-2">@Html.DisplayFor(model => model.IsClosed)</dd>
                        </dl>
                    </div>

                    <!-- Form with aligned and spaced buttons -->
                    <form asp-action="DeleteConfirmed" class="d-flex justify-content-end gap-2">
                        <input type="hidden" asp-for="Id" />

                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Cancel
                        </a>

                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-trash3-fill me-1"></i> Delete
                        </button>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

